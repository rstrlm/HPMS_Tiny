{
  "realm": "pms",
  "enabled": true,
  "displayName": "Lempäälä Spa PMS",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "manager",
        "description": "Full access to all PMS features"
      },
      {
        "name": "frontdesk",
        "description": "Reservations, customers, check-in/out, treatments"
      },
      {
        "name": "cleaner",
        "description": "View and update housekeeping tasks"
      },
      {
        "name": "maintenance",
        "description": "Create room blocks, maintenance tasks"
      },
      {
        "name": "therapist",
        "description": "View own schedule, update treatment status"
      },
      {
        "name": "accounting",
        "description": "Full access to billing, invoices, payments"
      }
    ]
  },
  "clients": [
    {
      "clientId": "pms-api",
      "name": "PMS API",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "pms-api-secret-change-in-production",
      "redirectUris": [
        "https://localhost:5001/*",
        "http://localhost:5000/*",
        "https://localhost:7001/*",
        "http://localhost:5134/*"
      ],
      "webOrigins": [
        "https://localhost:5001",
        "http://localhost:5000",
        "https://localhost:7001",
        "http://localhost:5134"
      ],
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "attributes": {
        "access.token.lifespan": "3600"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "pms-web",
      "name": "PMS Web Frontend",
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:3000"
      ],
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "access.token.lifespan": "3600",
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "pms-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "manager",
      "enabled": true,
      "email": "manager@lempaalaspa.fi",
      "firstName": "Test",
      "lastName": "Manager",
