# API Base URL (leave empty when using Vite proxy in development)
VITE_API_BASE_URL=

# Keycloak Configuration
# Set VITE_KEYCLOAK_URL to enable Keycloak authentication
# Leave empty or set VITE_DEV_MODE=true for local development with role switcher
VITE_KEYCLOAK_URL=http://localhost:8080/realms/pms
VITE_KEYCLOAK_CLIENT_ID=pms-web

# Dev Mode
# Set to "true" to use the role switcher instead of Keycloak
VITE_DEV_MODE=true

# Optional: Pre-select roles for development
VITE_DEV_ROLES=manager,cleaner,therapist
